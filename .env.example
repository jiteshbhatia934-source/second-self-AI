# Copy to .env and fill in values. Never commit .env.

# Required from Phase 2 (classify) and Phase 5 (ask)
GROQ_API_KEY=your_groq_api_key_here

# Optional path overrides (defaults: project-root raw/, wiki/, data/, graph.json)
# RAW_DIR=
# WIKI_DIR=
# DATA_DIR=
# GRAPH_PATH=

# Auto-link similarity cutoff (0.0–1.0). Default: 0.80
# SIMILARITY_THRESHOLD=0.80

# Number of wiki notes retrieved for RAG. Default: 8 (range 1–20)
# TOP_K_RETRIEVAL=8

# Local sentence-transformers model. Default: all-MiniLM-L6-v2
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Disable capture/pipeline sidebar on public Streamlit deploy. Default: false
# PUBLIC_DEMO=false
