# Copy to secrets.toml for local Streamlit testing (never commit secrets.toml).
# On Streamlit Community Cloud, paste equivalent TOML in App settings → Secrets.

GROQ_API_KEY = "your_groq_api_key_here"
PUBLIC_DEMO = "true"

# Optional overrides (defaults match .env.example)
# SIMILARITY_THRESHOLD = "0.80"
# TOP_K_RETRIEVAL = "8"
# EMBEDDING_MODEL = "all-MiniLM-L6-v2"
